{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "ES2024.String", "DOM"]
  },
  "include": [
    "verifier.ts",
    "test_vectors.ts",
    "test_policy_evaluation.ts",
    "test_browser_policy_evaluation.ts",
    "test_pseudonym_refs.ts",
    "test_seal.ts",
    "browser/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
