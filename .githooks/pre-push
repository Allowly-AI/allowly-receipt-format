#!/bin/sh
set -eu

if [ "${ALLOWLY_SKIP_MUTATION_GATE:-}" = "1" ]; then
  echo "Skipping mutation gate because ALLOWLY_SKIP_MUTATION_GATE=1"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if [ -x ".venv/bin/python" ]; then
  exec .venv/bin/python scripts/mutation_gate.py
fi

exec python3 scripts/mutation_gate.py
